pipeline {
    agent any
    
    environment {
        SERVICE_NAME = 'service_alertes'
        DOCKER_IMAGE = "aquawatch/${SERVICE_NAME}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code for ${SERVICE_NAME}..."
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Installing Node.js dependencies...'
                    bat 'npm ci'
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Running tests...'
                    bat 'npm test || exit 0'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Building Docker image...'
                    bat "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deploying service...'
                bat 'docker-compose up -d service_alertes'
            }
        }
    }
    
    post {
        success {
            echo "✅ Pipeline for ${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "❌ Pipeline for ${SERVICE_NAME} failed!"
        }
        always {
            echo 'Cleaning up...'
            cleanWs()
        }
    }
}
