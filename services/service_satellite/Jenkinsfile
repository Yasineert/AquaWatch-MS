pipeline {
    agent any
    
    environment {
        SERVICE_NAME = 'service_satellite'
        DOCKER_IMAGE = "aquawatch/${SERVICE_NAME}"
        SONAR_PROJECT_KEY = "aquawatch-${SERVICE_NAME}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code for ${SERVICE_NAME}..."
                checkout scm
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Setting up Python virtual environment...'
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Running Python tests...'
                    sh '''
                        . venv/bin/activate
                        pytest tests/ || true
                    '''
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarQube') {
                            sh "${scannerHome}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Building Docker image...'
                    sh "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deploying service...'
                sh """
                    cd /workspace
                    docker-compose up -d ${SERVICE_NAME}
                """
            }
        }
    }
    
    post {
        success {
            echo "✅ Pipeline for ${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "❌ Pipeline for ${SERVICE_NAME} failed!"
        }
        always {
            echo 'Cleaning up...'
            cleanWs()
        }
    }
}
