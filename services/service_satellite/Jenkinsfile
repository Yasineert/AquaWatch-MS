pipeline {
    agent any
    
    environment {
        SERVICE_NAME = 'service_satellite'
        DOCKER_IMAGE = "aquawatch/${SERVICE_NAME}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Checking out code for ${SERVICE_NAME}..."
                checkout scm
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Setting up Python virtual environment...'
                    bat '''
                        python -m venv venv
                        call venv\\Scripts\\activate.bat
                        python -m pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Running Python tests...'
                    bat '''
                        call venv\\Scripts\\activate.bat
                        pytest tests/ || exit 0
                    '''
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    echo 'Building Docker image...'
                    bat "docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deploying service...'
                bat 'docker-compose up -d service_satellite'
            }
        }
    }
    
    post {
        success {
            echo "✅ Pipeline for ${SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "❌ Pipeline for ${SERVICE_NAME} failed!"
        }
        always {
            echo 'Cleaning up...'
            cleanWs()
        }
    }
}
