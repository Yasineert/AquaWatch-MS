# AquaWatch-MS - environment variables
# 1. Copy this file to .env (cp .env.example .env)
# 2. Fill in your own values. Never commit .env (it is Git-ignored).

USER=aquawatch

# TimescaleDB / PostgreSQL
POSTGRES_USER=aquawatch_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aquawatch_db
POSTGRES_HOST=db_timescale
POSTGRES_PORT=5432

# MinIO (object storage for satellite files)
MINIO_ROOT_USER=aquawatch_admin
MINIO_ROOT_PASSWORD=change-me
MINIO_HOST=minio_storage
MINIO_PORT=9000
MINIO_BUCKET_NAME=aquawatch-data

# Service ports
SERVICE_CAPTEURS_PORT=8001
SERVICE_SATELLITE_PORT=8002
SERVICE_STMODEL_PORT=8003
SERVICE_ALERTES_PORT=8004
SERVICE_API_SIG_PORT=8005

# External APIs (create your own credentials)
SENTINEL_HUB_CLIENT_ID=change-me
SENTINEL_HUB_CLIENT_SECRET=change-me
COPERNICUS_API_KEY=change-me

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMS_PROVIDER_API_KEY=change-me

# Alert thresholds (WHO drinking-water guidelines)
PH_MIN=6.5
PH_MAX=8.5
TURBIDITY_MAX=4.0
TEMPERATURE_MAX=25.0
CONDUCTIVITY_MAX=1000.0

# Machine learning
ML_MODEL_PATH=/app/models
PREDICTION_HORIZON_HOURS=72
RETRAIN_INTERVAL_DAYS=7

# Runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
